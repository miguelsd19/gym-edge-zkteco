# Backend
BACKEND_BASE_URL=http://localhost:8000
DEVICE_TOKEN=replace-with-access-point-device-token
# rfid: el ID del lector se busca en el "ID biometrico" (rfid_code) que muestra la app.
# biometric: se busca en device_user_id (no se ve ni se edita desde la app).
ACCESS_MODE=rfid
REQUEST_TIMEOUT_SECONDS=3.0
POLL_INTERVAL_SECONDS=0.5
GRANTED_IDENTIFIER_COOLDOWN_SECONDS=3.0

# Archivos locales (relativos a la carpeta del servicio/binario)
LOG_FILE=runtime/edge_zkteco.log
FAILED_ATTEMPTS_FILE=runtime/failed_attempts_zkteco.jsonl
ZK_EVENT_LOG_FILE=runtime/zk_events.jsonl
ZK_STATE_FILE=runtime/zk_state.json

# Fuente de eventos: device (terminal ZKTeco real) o file (pruebas sin hardware)
ZK_EVENT_SOURCE=device
INPUT_FILE=runtime/input.txt

# Conexion al terminal ZKTeco (SpeedFace-V5L)
ZK_DEVICE_HOST=192.168.1.201
ZK_DEVICE_PORT=4370
# Comm key configurada en el terminal (0 = sin clave)
ZK_DEVICE_PASSWORD=0
ZK_DEVICE_TIMEOUT_SECONDS=5.0
ZK_FORCE_UDP=false
ZK_OMIT_PING=true

# Captura de eventos en vivo
ZK_CAPTURE_POLL_SECONDS=1.0
ZK_KEEPALIVE_SECONDS=30
ZK_RECONNECT_MAX_BACKOFF_SECONDS=30
ZK_COMMAND_TIMEOUT_SECONDS=10
ZK_MAX_EVENT_AGE_SECONDS=86400
# CSV de codigos permitidos; vacio = todos
ZK_ALLOWED_PUNCH_CODES=
ZK_ALLOWED_STATUS_CODES=

# Apertura de puerta
ZK_OPEN_DOOR_ON_GRANT=true
ZK_OPEN_DOOR_DURATION_SECONDS=3
ZK_OPEN_DOOR_RETRY_ATTEMPTS=2
ZK_OPEN_DOOR_RETRY_BACKOFF_SECONDS=0.5

# Sync de roles: grupo permitido vs bloqueado (el grupo bloqueado se configura
# en el terminal sin timezone de acceso valida)
ZK_ALLOWED_GROUP_ID=1
ZK_BLOCKED_GROUP_ID=99
ZK_USER_ROLE_SYNC_ENABLED=true
ZK_USER_ROLE_SYNC_INTERVAL_SECONDS=86400
ZK_USER_ROLE_SYNC_BACKEND_PATH=/api/access/hikvision-user-roles/

# Servidor de control (backend -> edge, expuesto via ngrok)
EDGE_CONTROL_ENABLED=true
EDGE_CONTROL_BIND_HOST=0.0.0.0
EDGE_CONTROL_PORT=9877
EDGE_CONTROL_PATH=/door/open
EDGE_ROLE_SYNC_PATH=/hikvision/user-role-sync

# Salud / recuperacion
ZK_RECOVERY_RESTART_SECONDS=300
EDGE_HEARTBEAT_LOG_SECONDS=60
EDGE_HEALTH_REPORT_INTERVAL_SECONDS=30
EDGE_WATCHDOG_ENABLED=true
EDGE_WATCHDOG_TIMEOUT_SECONDS=30
